# Backend (локально при docker compose up postgres + minio)
DATABASE_URL=postgres://marka:marka@localhost:5432/marka?sslmode=disable
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# MinIO (make docker-infra-up)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_password
MINIO_BUCKET=marka
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000/marka

# --- Docker Compose (весь стек: docker compose up -d --build) ---
# Подставьте IP или домен сервера для доступа снаружи:
# PUBLIC_HOST=203.0.113.10
# CORS_ALLOWED_ORIGINS=http://203.0.113.10:3000,http://203.0.113.10
# MINIO_PUBLIC_URL=http://203.0.113.10:9000/marka
# FRONTEND_PORT=3000
# ADMIN_PORT=80

# Admin-front (опционально; по умолчанию прокси /api → localhost:3001)
# VITE_API_BASE=/api
# VITE_API_PROXY_TARGET=http://localhost:3001

# Frontend (Next.js, серверный fetch к API)
# API_URL=http://localhost:3001
# NEXT_PUBLIC_API_URL=http://localhost:3001
